FROM docker.io/oven/bun:1.4.0@sha256:5ff609364c049b54eb0ff560ec96319729a972078ef2c755d758f0c6ef89c2d6 AS development
WORKDIR /app

# Copy package.json and lockfile
COPY package.json bun.lock* ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source code (will be overridden by bind mount in compose, but good for caching)
COPY . .

# Expose port (Vite default 5173)
EXPOSE 5173

# Run dev server with host binding
CMD ["bun", "run", "dev", "--", "--host"]
