FROM docker.io/oven/bun:1.4.3@sha256:ec06c3b6cea04192ae6770c434f668ca41d343ad19fa6472216c7b48be39c598 AS development
WORKDIR /app

# Copy package.json and lockfile
COPY package.json bun.lock* ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source code (will be overridden by bind mount in compose, but good for caching)
COPY . .

# Expose port (Vite default 5173)
EXPOSE 5173

# Run dev server with host binding
CMD ["bun", "run", "dev", "--", "--host"]
