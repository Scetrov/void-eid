FROM docker.io/oven/bun:1.3.6@sha256:766690ef3be36b73288435428c638e47b8500d01f8fa1c298c4b09dc29841197 AS development
WORKDIR /app

# Copy package.json and lockfile
COPY package.json bun.lock* ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source code (will be overridden by bind mount in compose, but good for caching)
COPY . .

# Expose port (Vite default 5173)
EXPOSE 5173

# Run dev server with host binding
CMD ["bun", "run", "dev", "--", "--host"]
