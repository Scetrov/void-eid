FROM docker.io/oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 AS development
WORKDIR /app

# Copy package.json and lockfile
COPY package.json bun.lock* ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source code (will be overridden by bind mount in compose, but good for caching)
COPY . .

# Expose port (Vite default 5173)
EXPOSE 5173

# Run dev server with host binding
CMD ["bun", "run", "dev", "--", "--host"]
