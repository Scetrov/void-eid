FROM docker.io/library/rust:1.96.0@sha256:c6811167278337db5f3b0234964ced5f538f154a2a20f09ec03721d7411c933d AS development

WORKDIR /usr/src/app

# Install cargo-watch
RUN cargo install cargo-watch --version 8.5.3 --locked

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Copy source code (will be overridden by bind mount)
COPY . .

# Expose API port
EXPOSE 5038

# Run with cargo-watch
CMD ["cargo", "watch", "-x", "run"]
