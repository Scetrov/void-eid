FROM docker.io/library/rust:1.96.0@sha256:4fd8406017c992f7b8ab55a2f99a1d56aeb1d7ecd255850dfa04239a88601f73 AS development

WORKDIR /usr/src/app

# Install cargo-watch
RUN cargo install cargo-watch --version 8.5.3 --locked

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Copy source code (will be overridden by bind mount)
COPY . .

# Expose API port
EXPOSE 5038

# Run with cargo-watch
CMD ["cargo", "watch", "-x", "run"]
