FROM docker.io/library/rust:1.96.0@sha256:6df234c1eb92b0545468fab8c18fc5f9adfb994e7d4f67d81d45fe2fcabf5657 AS development

WORKDIR /usr/src/app

# Install cargo-watch
RUN cargo install cargo-watch --version 8.5.3 --locked

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Copy source code (will be overridden by bind mount)
COPY . .

# Expose API port
EXPOSE 5038

# Run with cargo-watch
CMD ["cargo", "watch", "-x", "run"]
