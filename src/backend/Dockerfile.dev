FROM docker.io/library/rust:1.99.1@sha256:8a4e90c7946b74626488b1446f712c0fe0ed1a596cbd3d871684bc9c5433ae07 AS development

WORKDIR /usr/src/app

# Install cargo-watch
RUN cargo install cargo-watch --version 8.5.3 --locked

# Copy manifests
COPY Cargo.toml Cargo.lock ./

# Copy source code (will be overridden by bind mount)
COPY . .

# Expose API port
EXPOSE 5038

# Run with cargo-watch
CMD ["cargo", "watch", "-x", "run"]
